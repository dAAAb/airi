        "-B",
        "-m",
        "uvicorn",
        "server:app",
        "--app-dir",
        "{resources}/course/ntu-vh2026/asr26",
        "--host",
        "127.0.0.1",
        "--port",
        "18001",
        "--workers",
        "1",
        "--no-access-log"
      ],
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONNOUSERSITE": "1",
        "BREEZE_ASR26_MODEL_DIR": "{payload}/asr26/model"
      },
      "port": 18001,
      "health": "/health"
    },
